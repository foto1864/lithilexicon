rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'email', 'role'])
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'subscriber';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /entries/{id} {
      allow read: if resource.data.approved == true || isAdmin()
        || (signedIn() && resource.data.uploadedBy == request.auth.token.email);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'phrase', 'meaning', 'uploadedBy', 'uploadedByUsername', 'approved', 'timestamp'
        ])
        && request.resource.data.phrase is string
        && request.resource.data.phrase.size() > 0
        && request.resource.data.meaning is string
        && request.resource.data.meaning.size() > 0
        && request.resource.data.uploadedBy == request.auth.token.email
        && request.resource.data.uploadedByUsername == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.timestamp is timestamp
        && request.resource.data.approved is bool
        && (request.resource.data.approved == false || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /meaningSuggestions/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['entryId', 'phrase', 'meaning', 'uploadedBy', 'uploadedByUsername', 'timestamp'])
        && request.resource.data.entryId is string
        && get(/databases/$(database)/documents/entries/$(request.resource.data.entryId)).data.approved == true
        && request.resource.data.phrase == get(/databases/$(database)/documents/entries/$(request.resource.data.entryId)).data.phrase
        && request.resource.data.meaning is string
        && request.resource.data.meaning.size() > 0
        && request.resource.data.meaning.size() <= 5000
        && request.resource.data.uploadedBy == request.auth.token.email
        && request.resource.data.uploadedByUsername == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.timestamp is timestamp;
      allow read, delete: if isAdmin();
    }
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'timestamp'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.timestamp == request.time;
      allow read, delete: if isAdmin();
    }
    match /deletedAccounts/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'reason', 'deletedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.reason is string
        && request.resource.data.deletedAt is timestamp;
      allow read, delete: if isAdmin();
    }
  }
}
